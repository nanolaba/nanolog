<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nanolaba</groupId>
    <artifactId>nanolog</artifactId>
    <!-- mvnrepository and the IDEs show the name as the title: it says what the library is, unlike NanoLog for C++ -->
    <name>Nanolog Java logging</name>
    <url>https://github.com/nanolaba/nanolog</url>
    <description>Zero-dependency logging library for Java 8+: static LOG calls without logger fields, LOG.dbg print debugging that shows each expression with its value, an
        agent mode that cuts the tokens an AI coding agent reads from the console and ends the run with a summary, wide events with one
        canonical log line per request or job, structured fields and context, automatic caller detection, levels changed at run time, JSON lines, log capture in
        tests and a bridge to SLF4J.
    </description>

    <version>1.4-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the latest release on Maven Central, shown by README.src.md and agent-guide.src.md; bump after every release -->
        <nanolog.stableVersion>1.3</nanolog.stableVersion>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <maven.compiler.release>8</maven.compiler.release>
        <github.global.server>github</github.global.server>

        <!-- libs-->
        <junit5.version>5.10.2</junit5.version>
        <junit-platform.version>1.10.2</junit-platform.version>
        <slf4j.version>2.0.12</slf4j.version>
        <!-- the profile kotlin compiles its tests elsewhere, so a build without it never meets the Kotlin classes -->
        <test.output.directory>${project.build.directory}/test-classes</test.output.directory>
        <commons-lang3.version>3.17.0</commons-lang3.version>

        <!-- Maven plugins -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-clean-plugin.version>3.3.2</maven-clean-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
        <maven-install-plugin.version>3.1.1</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.1.1</maven-deploy-plugin.version>
        <maven-site-plugin.version>3.12.1</maven-site-plugin.version>
        <maven-project-info-reports-plugin.version>3.5.0</maven-project-info-reports-plugin.version>
        <nrg-maven-plugin.version>1.3</nrg-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.8.0</central-publishing-maven-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>

        <pitest-maven.version>1.15.8</pitest-maven.version>
        <pitest-junit5-plugin.version>1.2.1</pitest-junit5-plugin.version>
    </properties>

    <developers>
        <developer>
            <email>alexander@andriishin.com</email>
            <name>Alexander Andriishin</name>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/nanolaba/nanolog</url>
        <connection>scm:git:git://github.com/nanolaba/nanolog.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/nanolaba/nanolog.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/nanolaba/nanolog/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/nanolaba/nanolog/actions</url>
    </ciManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest-junit5-plugin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- only for NanologExtension, which a test of a user registers -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit5.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- only for SummaryListener, which JUnit loads through ServiceLoader in the test runs of a user -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit-platform.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testOutputDirectory>${test.output.directory}</testOutputDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- a run from a coding agent behaves like CI: the tests that need agent mode turn it on -->
                        <environmentVariables>
                            <NANOLOG_AGENT>off</NANOLOG_AGENT>
                        <NANOLOG_CONSOLE_COLOR>never</NANOLOG_CONSOLE_COLOR>
                            <!-- a FORCE_COLOR of the developer's shell must not colour the output the tests compare -->
                            <NANOLOG_CONSOLE_COLOR>never</NANOLOG_CONSOLE_COLOR>
                        </environmentVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <!-- the module name for a jar built on JDK 8, which has no module descriptor; on JDK 9+ the
                                     profile java9-module adds META-INF/versions/9/module-info.class with the same name -->
                                <Automatic-Module-Name>com.nanolaba.nanolog</Automatic-Module-Name>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven-deploy-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>${maven-project-info-reports-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest-maven.version}</version>
                <configuration>
                    <verbose>true</verbose>
                    <mutationThreshold>100</mutationThreshold>
                    <environmentVariables>
                        <NANOLOG_AGENT>off</NANOLOG_AGENT>
                        <NANOLOG_CONSOLE_COLOR>never</NANOLOG_CONSOLE_COLOR>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>pitest</id>
                        <phase>test</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.nanolaba</groupId>
                <artifactId>nrg-maven-plugin</artifactId>
                <version>${nrg-maven-plugin.version}</version>
                <configuration>
                    <file>
                        <item>README.src.md</item>
                        <item>agent-guide.src.md</item>
                        <item>SUPPORT.src.md</item>
                        <item>CONTRIBUTING.src.md</item>
                        <item>SECURITY.src.md</item>
                    </file>
                </configuration>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>create-files</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <!-- every public and protected member must be documented: the build fails on a missing comment -->
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${maven-gpg-plugin.version}</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                    <deploymentName>Nanolog ${project.version}</deploymentName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            A real module descriptor, so jlink accepts the jar: src/main/java9/module-info.java is compiled with release 9
            into META-INF/versions/9 of a multi-release jar, and every other class stays Java 8 bytecode. javac 8 cannot
            compile it, so the profile is active from JDK 9 on, and a release must be built there.
            src/it/jlink/run.sh checks the jar with jlink.
        -->
        <profile>
            <id>java9-module</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>module-info</id>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <release>9</release>
                                    <multiReleaseOutput>true</multiReleaseOutput>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/main/java9</compileSourceRoot>
                                    </compileSourceRoots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <archive>
                                <manifestEntries>
                                    <Multi-Release>true</Multi-Release>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Calls of LOG from Kotlin: compiles src/test/kotlin, so an overload that makes a call ambiguous for Kotlin
            fails the build, and KotlinCallersTest runs the calls once. CI runs
            mvn -P kotlin test-compile surefire:test -Dtest=KotlinCallersTest on JDK 17. The test classes of this profile
            go to target/kotlin-test-classes, so a build without it, pitest included, never meets the Kotlin classes
            without the Kotlin library. Test scope only: the published jar and its dependencies do not change.
        -->
        <profile>
            <id>kotlin</id>
            <properties>
                <kotlin.version>2.4.21</kotlin.version>
                <test.output.directory>${project.build.directory}/kotlin-test-classes</test.output.directory>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib</artifactId>
                    <version>${kotlin.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-plugin</artifactId>
                        <version>${kotlin.version}</version>
                        <executions>
                            <execution>
                                <id>test-compile</id>
                                <phase>test-compile</phase>
                                <goals>
                                    <goal>test-compile</goal>
                                </goals>
                                <configuration>
                                    <sourceDirs>
                                        <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
                                    </sourceDirs>
                                    <jvmTarget>1.8</jvmTarget>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            SLF4J 1.7 instead of 2.x, to test Slf4jLogger against the older API many applications still run:
            mvn -P slf4j-1.7 clean test-compile surefire:test -Dtest=... (CI runs it on JDK 8, JUnit only). The README
            is not generated: it names the SLF4J version of the main build.
        -->
        <profile>
            <id>slf4j-1.7</id>
            <properties>
                <slf4j.version>1.7.36</slf4j.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.nanolaba</groupId>
                        <artifactId>nrg-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            CallerDetection.StackWalk uses java.lang.StackWalker (Java 9+): on Java 8 it can never run, so pitest
            leaves it out there. It is mutated on every newer JDK, where it is the locator LOG uses.
        -->
        <profile>
            <id>pitest-java8</id>
            <activation>
                <jdk>1.8</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <excludedClasses>
                                <param>com.nanolaba.logging.CallerDetection$StackWalk</param>
                            </excludedClasses>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            The legacy walk uses internal APIs of Java 8 and cannot be created on a newer JDK, so pitest leaves it out
            there. It is mutated on JDK 8, where it is the locator LOG uses.
        -->
        <profile>
            <id>pitest-java9</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <excludedClasses>
                                <param>com.nanolaba.logging.CallerDetection$LegacyWalk</param>
                            </excludedClasses>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            JMH benchmarks in src/jmh/java, never part of the default build, CI or the published jar:
                mvn -P benchmark test-compile exec:exec
            -Djmh.java=<path to bin/java> runs them on another JVM, -Djmh.args="..." passes JMH options.
        -->
        <profile>
            <id>benchmark</id>
            <properties>
                <jmh.version>1.37</jmh.version>
                <jmh.java>${java.home}/bin/java</jmh.java>
                <jmh.args/>
                <build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
                <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-core</artifactId>
                    <version>${jmh.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${build-helper-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>add-benchmark-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/jmh/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-testCompile</id>
                                <configuration>
                                    <!-- an explicit processor path: javac 23+ no longer runs processors found on the classpath -->
                                    <annotationProcessorPaths>
                                        <path>
                                            <groupId>org.openjdk.jmh</groupId>
                                            <artifactId>jmh-generator-annprocess</artifactId>
                                            <version>${jmh.version}</version>
                                        </path>
                                    </annotationProcessorPaths>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <configuration>
                            <executable>${jmh.java}</executable>
                            <classpathScope>test</classpathScope>
                            <commandlineArgs>-classpath %classpath org.openjdk.jmh.Main ${jmh.args}</commandlineArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
